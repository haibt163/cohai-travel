# Public production URL used for canonical links, Open Graph URLs and sitemap.
# VITE_* values are inlined at BUILD time: set this in Vercel (Production) before the
# build, then redeploy. Production builds fail if it is missing or points at localhost.
VITE_SITE_URL="https://example.com"

# Neon (or any Postgres) connection string.
# Preview hosts inject this. Standalone checkout: paste the Neon URI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"
VITE_BETTER_AUTH_URL="http://localhost:3000"

# Google and X sign-in go through the Grok auth broker (src/lib/auth/server.ts),
# NOT directly to Google/X. The per-app broker client below is required in
# production. If it is missing, the server silently falls back to a preview-only
# client that the broker accepts only for *.grok-sandbox.com callbacks.
# GROK_AUTH_ISSUER is optional (defaults to https://auth.grok.me).
GROK_AUTH_ISSUER="https://auth.grok.me"
GROK_AUTH_CLIENT_ID=""
GROK_AUTH_CLIENT_SECRET=""

# Comma-separated Better Auth user ids allowed to see the operator desk.
# Leave empty to keep operator tools hidden.
COHAI_OPERATOR_USER_IDS=""
